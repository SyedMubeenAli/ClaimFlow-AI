# Copy this file to .env and fill it in. .env is ignored by git; never commit real keys.
# Every value is optional. With nothing set, the app starts in Demo Mode (offline, no key needed).

# Which AI provider to use: fake (offline test provider), gemini, groq or openrouter.
LLM_PROVIDER=fake

# API keys. You only need the one for the provider you chose.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model names change often. If a name is rejected, the Settings page says so.
# Check the provider's current model list and set the name here.
# Defaults when empty: gemini-2.5-flash, llama-3.3-70b-versatile, meta-llama/llama-3.3-70b-instruct
LLM_MODEL=
# Model used for damage photos. Empty means the main model for Gemini, and no vision for the others.
VISION_MODEL=

# Demo Mode runs the whole workflow offline with a scripted model. No key or internet needed.
# Leave it unset for the default: on when no provider is configured, off when one is.
# Set DEMO_MODE=false (and a provider key above) for live AI. The sidebar switch changes it while running.
DEMO_MODE=true
# Save every model answer to disk and reuse it for an identical request.
LLM_CACHE=true

# Where things are stored. Relative paths start at the project folder.
DATABASE_PATH=data/claimflow.db
UPLOAD_DIR=data/uploads
LLM_CACHE_DIR=data/llm_cache
LOG_DIR=logs
LOG_LEVEL=INFO

# Policy search (RAG). Embeddings turn policy text into vectors for similarity search.
#   auto       use the fastembed model below, or fall back to offline hashing if it cannot start
#   fastembed  same as auto, for when you want to be explicit
#   hashing    offline, no model download. It matches on wording, not meaning.
EMBEDDING_BACKEND=auto
# The model is downloaded once, on first use. Changing it rebuilds saved policy indexes automatically.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
INDEX_DIR=data/policy_index

# Upload limit in MB (1 to 50). If you raise it, also raise maxUploadSize in .streamlit/config.toml.
MAX_UPLOAD_MB=10

# Seconds to wait for a provider, and the pause before the one automatic retry.
LLM_TIMEOUT_S=60
LLM_RETRY_DELAY_S=1.5
